# Environment Variables Template

# Copy this file to .env and fill in your values

# ===========================================
# AI/LLM Configuration
# ===========================================

# OpenAI API Key (for GPT-4o-mini or other OpenAI models)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Ollama Configuration (local LLM alternative)
# Install Ollama: https://ollama.ai
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# ===========================================
# News API Configuration
# ===========================================

# NewsAPI Key (for fetching news articles)
# Get your key at: https://newsapi.org
NEWS_API_KEY=your_newsapi_key_here

# GDELT API (alternative, no key required but has rate limits)
GDELT_ENABLED=true

# ===========================================
# Backend Configuration
# ===========================================

# FastAPI Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database (SQLite for metadata)
DATABASE_URL=sqlite:///./data/metadata.db

# Cache Configuration
CACHE_TTL_SECONDS=300
CACHE_DIR=.cache

# ===========================================
# Frontend Configuration
# ===========================================

# React Development Server
VITE_API_URL=http://localhost:8000

# ===========================================
# Data Configuration
# ===========================================

# yfinance settings
YFINANCE_PERIOD=1y
YFINANCE_INTERVAL=1d

# News lookback period (days)
NEWS_LOOKBACK_DAYS=90

# ===========================================
# Trading Configuration
# ===========================================

# Default backtest parameters
DEFAULT_INITIAL_CAPITAL=10000
DEFAULT_COMMISSION=0.001
DEFAULT_SLIPPAGE=0.0005

# ===========================================
# Logging Configuration
# ===========================================

LOG_LEVEL=INFO
LOG_FILE=logs/app.log
